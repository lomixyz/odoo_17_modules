<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Delivery smart button -->
    <record id="view_move_form_inherit_delivery" model="ir.ui.view">
        <field name="name">account.move.form.inherit.delivery</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_delivery_orders"
                        class="oe_stat_button"
                        type="object"
                        icon="fa-truck"
                        invisible="delivery_count == 0 or move_type not in ('out_invoice', 'out_refund')">
                    <field name="delivery_count" widget="statinfo" string="Deliveries"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Available Qty column on invoice lines -->
    <record id="view_move_form_inherited_avail_qty" model="ir.ui.view">
        <field name="name">account.move.form.inherited.avail.qty</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="after">
                <field name="idm_qty_warning" column_invisible="True"/>
                <field name="idm_is_storable" column_invisible="True"/>
                <field name="available_qty" readonly="1" optional="show"
                       invisible="not idm_is_storable"
                       decoration-danger="idm_qty_warning"
                       decoration-bf="idm_qty_warning"/>
            </xpath>
        </field>
    </record>

    <!-- Stock options + status on the invoice -->
    <record id="view_move_form_inherit_idm_stock" model="ir.ui.view">
        <field name="name">account.move.form.inherit.idm.stock</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="state != 'posted' or delivery_status != 'pending' or move_type not in ('out_invoice', 'out_refund')">
                    <i class="fa fa-truck me-1" title="Stock"/>
                    The stock transfer of this document is waiting for validation.
                </div>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']/field[@name='delivery_date']" position="after">
                <field name="idm_update_stock" readonly="state != 'draft'"/>
                <field name="idm_warehouse_id"
                       invisible="not idm_update_stock"
                       required="idm_update_stock and state == 'draft'"
                       readonly="state != 'draft'"
                       groups="stock.group_stock_multi_warehouses"
                       options="{'no_create': True}"/>
                <field name="delivery_status" widget="badge"
                       invisible="delivery_status in (False, 'none')"
                       decoration-success="delivery_status == 'done'"
                       decoration-warning="delivery_status in ('pending', 'partial')"
                       decoration-muted="delivery_status == 'returned'"/>
            </xpath>
        </field>
    </record>

    <!-- Delivery status in the customer invoices / credit notes lists -->
    <record id="view_out_invoice_tree_inherit_idm" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.inherit.idm</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="delivery_status" widget="badge" optional="show"
                       invisible="delivery_status in (False, 'none')"
                       decoration-success="delivery_status == 'done'"
                       decoration-warning="delivery_status in ('pending', 'partial')"
                       decoration-muted="delivery_status == 'returned'"/>
            </field>
        </field>
    </record>

    <record id="view_out_credit_note_tree_inherit_idm" model="ir.ui.view">
        <field name="name">account.out.credit.note.tree.inherit.idm</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_credit_note_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="delivery_status" widget="badge" optional="show" string="Return Status"
                       invisible="delivery_status in (False, 'none')"
                       decoration-success="delivery_status == 'done'"
                       decoration-warning="delivery_status in ('pending', 'partial')"
                       decoration-muted="delivery_status == 'returned'"/>
            </field>
        </field>
    </record>

    <!-- Filters -->
    <record id="view_account_invoice_filter_inherit_idm" model="ir.ui.view">
        <field name="name">account.invoice.select.inherit.idm</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late']" position="after">
                <separator/>
                <filter string="Delivery Waiting" name="idm_delivery_waiting"
                        domain="[('delivery_status', 'in', ('pending', 'partial'))]"/>
                <filter string="Delivered" name="idm_delivery_done"
                        domain="[('delivery_status', '=', 'done')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Delivery Status" name="idm_group_delivery_status"
                        context="{'group_by': 'delivery_status'}"/>
            </xpath>
        </field>
    </record>

</odoo>
