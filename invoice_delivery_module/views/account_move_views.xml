<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_inherit_delivery" model="ir.ui.view">
        <field name="name">account.move.form.inherit.delivery</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                    <button name="action_view_delivery_orders"
                            class="oe_stat_button"
                            type="object"
                            string="Deliveries "
                            icon="fa-truck"
                            invisible="delivery_count == 0 or move_type != 'out_invoice'">
                        <field name="delivery_count" widget="statinfo"/>
                    </button>
            </div>
        </field>
    </record>

     <record id="view_move_form_inherited" model="ir.ui.view">
        <field name="name">account.move.form.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="available_qty" readonly="1"/>
            </xpath>
        </field>
    </record>


</odoo>
